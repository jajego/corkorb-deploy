# FastAPI app
APP_NAME=CorkOrb API
APP_ENV=local
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ALLOWED_ORIGINS_RAW=http://localhost:5173,http://127.0.0.1:5173

# Database
# Railway will provide DATABASE_URL automatically
APP_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/corkorb
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/corkorb

# Redis
# Railway will provide REDIS_URL automatically if Redis service is added
APP_REDIS_URL=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Clerk Authentication
# Get these from https://dashboard.clerk.com/
# Secret Key: Used for backend JWT verification
# Publishable Key: Used for frontend (React)
APP_CLERK_SECRET_KEY=sk_test_...
CLERK_SECRET_KEY=sk_test_...
APP_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Legacy Auth (for backward compatibility)
APP_JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
APP_JWT_ALGORITHM=RS256

# AWS S3 Configuration
# Get these from AWS Console: https://console.aws.amazon.com/
# 1. Create S3 bucket
# 2. Create IAM user with S3 permissions
# 3. Generate access key for IAM user
APP_AWS_ACCESS_KEY_ID=AKIA...
AWS_ACCESS_KEY_ID=AKIA...
APP_AWS_SECRET_ACCESS_KEY=wJalr...
AWS_SECRET_ACCESS_KEY=wJalr...
APP_AWS_REGION=us-east-1
AWS_REGION=us-east-1
APP_AWS_S3_BUCKET_NAME=corkorb-images
AWS_S3_BUCKET_NAME=corkorb-images

# CDN Configuration (CloudFront or Cloudflare)
# CloudFront: Get from AWS Console after creating distribution
# Format: https://d1234abcd5678.cloudfront.net
APP_CDN_BASE_URL=https://d1234abcd5678.cloudfront.net
CDN_BASE_URL=https://d1234abcd5678.cloudfront.net

# AWS Rekognition Configuration
# Minimum confidence threshold for moderation labels (0-100)
# Labels with confidence below this are ignored
APP_REKOGNITION_MIN_CONFIDENCE=50.0
REKOGNITION_MIN_CONFIDENCE=50.0

